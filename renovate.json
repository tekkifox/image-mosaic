{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "Europe/London",
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "rangeStrategy": "bump",
  "minimumReleaseAge": "12 hours",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "dependencies"],
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies",
      "separateMajorMinor": false,
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "groupName": "Node dependencies",
      "separateMajorMinor": false,
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["packageManager"],
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm package manager",
      "separateMajorMinor": false,
      "automerge": false,
      "labels": ["dependencies", "toolchain"]
    },
    {
      "description": "Hold engines.node: Vercel only offers Node 24.x, so Renovate raising it (for example to >=26) silently blocks deployments while CI stays green. Change this range deliberately.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "enabled": false
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "Docker base images",
      "separateMajorMinor": false,
      "automerge": false,
      "labels": ["dependencies", "toolchain"]
    },
    {
      "matchManagers": ["gomod", "dockerfile", "github-actions"],
      "matchPackageNames": ["go", "golang", "actions/setup-go", "actions/go-versions"],
      "groupName": "Go toolchain",
      "separateMajorMinor": false,
      "automerge": false,
      "labels": ["dependencies", "toolchain"]
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    }
  ]
}
