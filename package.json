{
  "name": "image-mosaic",
  "version": "1.0.0",
  "description": "PhotoPrism image mosaic gallery with travel blog",
  "main": "index.php",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "watch": "webpack --mode development --watch",
    "test": "pnpm run test:unit && pnpm run test:go && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:go": "go test ./...",
    "test:e2e": "pnpm run build && playwright test"
  },
  "keywords": [
    "photography",
    "gallery",
    "travel",
    "photoprism"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "cssnano": "^9.9.0",
    "jsdom": "^30.1.3",
    "mini-css-extract-plugin": "^2.10.2",
    "terser-webpack-plugin": "^5.6.1",
    "vitest": "^5.0.5",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
