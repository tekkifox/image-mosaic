{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "dev": true
    }
  },
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in main|dev) exit 1 ;; *) exit 0 ;; esac",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://travelling.rossmoney.me/api/:path*"
    }
  ]
}
